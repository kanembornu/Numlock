{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "numlock",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Local",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "numlock-explore-free": {
          "name": "NUMLOCK Explore Free"
        },
        "numlock-sol": {
          "name": "NUMLOCK Sol"
        },
        "numlock-sol-premium": {
          "name": "NUMLOCK Sol Premium"
        }
      }
    }
  },
  "model": "9router/numlock-explore-free",
  "small_model": "9router/numlock-explore-free",
  "enabled_providers": [
    "9router"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "permission": {
    "bash": {
      "clasp status": "allow",
      "clasp deployments": "allow",
      "clasp versions": "allow",
      "clasp clone *": "allow",
      "clasp pull": "allow",
      "clasp pull --projectDir *": "allow",
      "clasp push --force": "allow",
      "mkdir *": "allow",
      "diff *": "allow",
      "codegraph explore*": "allow",
      "codegraph status*": "allow",
      "git *": "allow",
      "pwd": "allow",
      "node tests/browser/*.js": "ask",
      "node --check tests/browser/*.js": "allow",
      "clasp version *": "ask",
      "clasp deploy *": "ask",
      "npm install --package-lock-only --ignore-scripts": "ask",
      "rm -rf tests/tmp/": "allow",
      "*": "deny"
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "numlock",
  "provider": {
    "9router": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "9Router Local",
      "options": {
        "baseURL": "http://127.0.0.1:20128/v1"
      },
      "models": {
        "numlock-explore-free": {
          "name": "NUMLOCK Explore Free"
        }
      }
    }
  },
  "model": "9router/numlock-explore-free",
  "small_model": "9router/numlock-explore-free",
  "enabled_providers": [
    "9router"
  ],
  "instructions": [
    "AGENTS.md"
  ],
  "permissions": [
    { "action": "*", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.clasprc.json", "effect": "deny" },
    { "action": "read", "resource": "*credentials*", "effect": "deny" },
    { "action": "read", "resource": "*token*.json", "effect": "deny" },
    { "action": "read", "resource": "*auth.json", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.clasp.json", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "pwd", "effect": "allow" },
    { "action": "shell", "resource": "git status", "effect": "allow" },
    { "action": "shell", "resource": "git status --short", "effect": "allow" },
    { "action": "shell", "resource": "git diff --check", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse HEAD", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git rev-parse *", "effect": "allow" },
    { "action": "shell", "resource": "node --check *", "effect": "allow" },
    { "action": "shell", "resource": "node --test *", "effect": "allow" },
    { "action": "shell", "resource": "node _test_runner.js", "effect": "allow" },
    { "action": "shell", "resource": "node _test_runner.js *", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/preflight.js", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/preflight.js *", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/runtime-preflight.js", "effect": "allow" },
    { "action": "shell", "resource": "node scripts/runtime-preflight.js *", "effect": "allow" },
    { "action": "shell", "resource": "clasp *", "effect": "deny" },
    { "action": "shell", "resource": "clasp status", "effect": "allow" },
    { "action": "shell", "resource": "clasp status *", "effect": "allow" },
    { "action": "shell", "resource": "clasp versions", "effect": "allow" },
    { "action": "shell", "resource": "clasp versions *", "effect": "allow" },
    { "action": "shell", "resource": "clasp deployments", "effect": "allow" },
    { "action": "shell", "resource": "clasp deployments *", "effect": "allow" },
    { "action": "shell", "resource": "clasp pull *", "effect": "allow" },
    { "action": "shell", "resource": "clasp push *", "effect": "allow" },
    { "action": "shell", "resource": "clasp version *", "effect": "allow" },
    { "action": "shell", "resource": "clasp deploy *", "effect": "allow" },
    { "action": "shell", "resource": "clasp run *", "effect": "allow" },
    { "action": "shell", "resource": "clasp logs *", "effect": "allow" }
  ]
}

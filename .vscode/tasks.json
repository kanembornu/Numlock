{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "NUMLOCK: Build Tailwind",
      "type": "shell",
      "command": "npm run build:tailwind",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "NUMLOCK: Clasp Status",
      "type": "shell",
      "command": "clasp status",
      "problemMatcher": []
    },
    {
      "label": "NUMLOCK: Clasp Push",
      "type": "shell",
      "command": "clasp push",
      "problemMatcher": []
    },
    {
      "label": "clasp pull",
      "type": "shell",
      "command": "clasp pull",
      "problemMatcher": []
    },
    {
      "label": "NUMLOCK: Preflight",
      "type": "shell",
      "command": "/bin/zsh",
      "args": [
        "-lc",
        "npm ci && npm run build:tailwind && for file in [0-9]*.js; do node --check \"$file\" || exit 1; done && clasp status"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
